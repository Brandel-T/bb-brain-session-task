# Copy this file to .env and fill in the values you were given.

# Required: your personal API key from the platform (avatar menu, API Access)
BB_TOKEN=your_api_token_here

# Required: base URL for the Blocky API
BB_URL=https://api.theblockbrain.ai/blocky/v2

# Required: ID of the bot you created in the demo environment
BB_BOT_ID=your_bot_id_here
